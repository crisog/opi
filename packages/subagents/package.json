  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.13.3",
    "typebox": "1.3.11",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.19.0"
  }
